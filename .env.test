# define your env variables for the test env here
KERNEL_CLASS='Nsv\WebApp\Core\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Tests use their own database, which tests/bootstrap.php rebuilds from
# dev/dbinit/ at the start of every phpunit run (skip with SKIP_DB_RESET=1).
# Both connections point to the same database, like in .env.
LEAGUE_DATABASE_URL="mysql://docker:docker@nsv-database:3306/nsv-test?serverVersion=5.7&charset=latin1"
MAIN_DATABASE_URL="mysql://docker:docker@nsv-database:3306/nsv-test?serverVersion=5.7"

# Some snapshot tests compare HTML output with script tags. Enable dev
# mode in order to get consistent file paths.
NSV_JS_DEV=true
NSV_NG_DEV=true

